# ElevenLabs API key — powers the voice layer (required for the phone demo).
# Starts with sk_...  Get it at elevenlabs.io → API Keys.
ELEVENLABS_API_KEY=sk_...

# Anthropic API key — powers Claude as the agent's brain (optional).
# Starts with sk-ant-...  Without it, the demo uses ElevenLabs' built-in LLM.
ANTHROPIC_API_KEY=sk-ant-...

# Public URL where THIS server is reachable (e.g. an ngrok https URL).
# Required only to route the ElevenLabs agent through the Claude bridge,
# because ElevenLabs must be able to reach /v1/chat/completions.
PUBLIC_BASE_URL=

# Shared passcode gating the app (recommended when hosted publicly).
# Leave blank for open access (fine for local dev).
APP_PASSCODE=

# Optional overrides
CLAUDE_MODEL=claude-opus-5
PORT=8787
